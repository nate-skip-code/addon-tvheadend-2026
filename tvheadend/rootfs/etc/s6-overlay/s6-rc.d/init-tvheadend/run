#!/command/with-contenv bashio
# shellcheck shell=bash
# ==============================================================================
# Home Assistant Community Add-on: TVHeadend
# Prepares the TVHeadend configuration and the optional WebGrab+Plus grabber
# ==============================================================================
declare -r CONFIG_DIR="/config/tvheadend"
declare -r WG_DIR="${CONFIG_DIR}/wg++"
declare -r WG_URL="https://www.webgrabplus.com/sites/default/files/download/SW/V3.3.0/WebGrabPlus_V3.3_install.tar.gz"
declare -r WG_SITEINI_URL="https://www.webgrabplus.com/sites/default/files/download/ini/SiteIniPack_current.zip"
declare -r WG_GRABBER_URL="https://www.webgrabplus.com/sites/default/files/tv_grab_wg.txt"

# WebGrab+Plus lives in /config, so it survives add-on updates, but the mono
# runtime it needs does not - the container filesystem is rebuilt on every
# update. Its dependencies are therefore (re)installed on each start.
webgrabplus_install_deps() {
    bashio::log.info '[WebGrab+] Installing the mono runtime...'
    apk add --no-cache mono unzip
}

# WebGrab+Plus is considered installed when its runner script is present.
webgrabplus_is_installed() {
    [[ -x "${WG_DIR}/run.sh" ]]
}

# Downloads and installs WebGrab+Plus into /config. Returns non-zero on any
# failure; the caller decides what to do with that - a failed grabber install
# must never take the add-on down, TVHeadend works fine without it.
webgrabplus_install() {
    bashio::log.info '[WebGrab+] Downloading WebGrab+Plus...'
    rm -rf /tmp/.wg++ /tmp/wgpp.tar.gz
    curl -fsSL -o /tmp/wgpp.tar.gz "${WG_URL}" \
        && tar -xzf /tmp/wgpp.tar.gz -C /tmp \
        && rm -f /tmp/wgpp.tar.gz \
        && mkdir -p "${WG_DIR}" \
        && cp -a /tmp/.wg++/. "${WG_DIR}/" \
        && rm -rf /tmp/.wg++ \
        || return 1

    bashio::log.info '[WebGrab+] Running the WebGrab+Plus installer...'
    (
        cd "${WG_DIR}" || exit 1
        ./install.sh || exit 1
        rm -rf siteini.pack/
        curl -fsSL -o SiteIniPack_current.zip "${WG_SITEINI_URL}" || exit 1
        unzip -q -o SiteIniPack_current.zip || exit 1
        rm -f SiteIniPack_current.zip
    ) || return 1

    bashio::log.info '[WebGrab+] Installing the tv_grab_wg++ grabber...'
    curl -fsSL -o /usr/bin/tv_grab_wg++ "${WG_GRABBER_URL}" \
        && sed -i "s|~/.wg++/guide.xml|${WG_DIR}/guide.xml|g" /usr/bin/tv_grab_wg++ \
        && chmod a+x /usr/bin/tv_grab_wg++ \
        || return 1

    return 0
}

# Reports the tuners visible inside the container. TVHeadend can only use
# adapters the host kernel has already bound and exposed under /dev/dvb - the
# add-on cannot load kernel modules or firmware on the host's behalf, so an
# empty list here is always a host-side problem, not a TVHeadend one.
report_dvb_adapters() {
    local adapter
    local error
    local frontend
    local -a adapters
    local -a frontends

    if [[ ! -d /dev/dvb ]]; then
        bashio::log.warning \
            'No /dev/dvb in this container - no DVB tuner was detected.' \
            'The host needs the kernel driver and firmware for your tuner' \
            'before TVHeadend can see it. See the add-on documentation.'
        return 0
    fi

    mapfile -t adapters < <(find /dev/dvb -mindepth 1 -maxdepth 1 -name 'adapter*' | sort)
    if bashio::var.equals "${#adapters[@]}" 0; then
        bashio::log.warning \
            '/dev/dvb exists but contains no adapters - no DVB tuner was' \
            'detected. Check the host kernel log for driver or firmware' \
            'errors. See the add-on documentation.'
        return 0
    fi

    bashio::log.info "Detected ${#adapters[@]} DVB adapter(s):"
    for adapter in "${adapters[@]}"; do
        mapfile -t frontends < <(find "${adapter}" -name 'frontend*' | sort)
        bashio::log.info "  ${adapter} (${#frontends[@]} frontend(s))"

        # Seeing the node is not the same as being allowed to use it. A
        # container can have the device node bind-mounted while the cgroup
        # device policy still denies open(), and TVHeadend reports that by
        # silently listing no adapters at all. Probe it here so the reason
        # ends up in this log instead.
        for frontend in "${frontends[@]}"; do
            if error=$( (: < "${frontend}") 2>&1 ); then
                bashio::log.info "    ${frontend}: opened OK"
            else
                bashio::log.error \
                    "    ${frontend}: cannot open (${error##*: })." \
                    'TVHeadend will not list this adapter. The device node is' \
                    'mapped but not usable - the container is missing' \
                    'permission for it.'
            fi
        done
    done
}

# Ensure the configuration directory exists and is initialized
if ! bashio::fs.directory_exists "${CONFIG_DIR}"; then
    bashio::log.info "Creating default configuration directory at ${CONFIG_DIR}"
    mkdir -p "${CONFIG_DIR}/recordings" \
        || bashio::exit.nok "Failed creating ${CONFIG_DIR}"
    timeout 20s /usr/bin/tvheadend --firstrun -u root -g root -c "${CONFIG_DIR}" \
        || bashio::log.warning 'First run initialization did not complete cleanly'
fi

# Set up the optional EPG grabber, but never fail the add-on over it
if ! bashio::config.true 'webgrabplus'; then
    bashio::log.info '[WebGrab+] Disabled in the add-on configuration, skipping'
elif ! webgrabplus_install_deps; then
    bashio::log.warning \
        '[WebGrab+] Could not install the mono runtime, skipping the grabber.'
elif webgrabplus_is_installed; then
    bashio::log.info '[WebGrab+] Already installed'
elif webgrabplus_install; then
    bashio::log.info '[WebGrab+] Installation completed successfully'
else
    bashio::log.warning \
        '[WebGrab+] Installation failed, continuing without the grabber.' \
        'Check the log above; the add-on retries on the next start.'
    rm -rf "${WG_DIR}"
fi

# Schedule the nightly EPG grab only when the grabber is actually usable
mkdir -p /etc/crontabs
if webgrabplus_is_installed && bashio::config.true 'webgrabplus'; then
    echo "0 0 * * * ${WG_DIR}/run.sh" > /etc/crontabs/root
else
    rm -f /etc/crontabs/root
fi

report_dvb_adapters

bashio::log.info 'Initialization completed'
