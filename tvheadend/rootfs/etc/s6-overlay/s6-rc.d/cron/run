#!/command/with-contenv bashio
# shellcheck shell=bash
# ==============================================================================
# Home Assistant Community Add-on: TVHeadend
# Runs the cron daemon
# ==============================================================================
mkdir -p /etc/crontabs

# busybox crond counts down for verbosity: -l 0 is its debug level and
# dumps the parsed crontab bitfields every wakeup. 8 is the default and
# still logs the jobs it runs.
exec fdmove -c 2 1 /usr/sbin/crond -f -L /dev/stdout -l 8 -c /etc/crontabs
